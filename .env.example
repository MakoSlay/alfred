# Alfred environment configuration.
# Copy to `.env`, or export these in your shell before starting Alfred.

# ── Model (required) ─────────────────────────────────────────────
# Any OpenAI-compatible chat endpoint works. Defaults target DeepSeek.
ALFRED_LLM_ENDPOINT=https://api.deepseek.com/v1
ALFRED_LLM_MODEL=deepseek-chat
ALFRED_LLM_API_KEY=

# ── Daemon ───────────────────────────────────────────────────────
ALFRED_HOST=127.0.0.1
ALFRED_PORT=47321
ALFRED_LOCAL_TOKEN=dev-local-token

# ── Voice (optional) ─────────────────────────────────────────────
# off | wispr | native
ALFRED2_LISTENER=off
ALFRED2_WAKE_WORDS=alfred,hey alfred,okay alfred,ok alfred
# ALFRED2_NATIVE_WAKE_COMMAND=/path/to/local-wake-helper
# ALFRED2_NATIVE_TRANSCRIBE_COMMAND=/path/to/record-and-transcribe-once

# ── Google integration (optional, read-only) ─────────────────────
# Place your OAuth Desktop App JSON at the path below, then run `pnpm run google:auth`.
# GOOGLE_OAUTH_CLIENT_PATH=~/.alfred/google/oauth-client.json
# GOOGLE_OAUTH_TOKEN_PATH=~/.alfred/google/oauth-token.json
# GOOGLE_SCOPES=
