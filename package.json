{
  "name": "alfred-local",
  "version": "0.1.0",
  "private": true,
  "description": "A local, cmux-backed personal assistant runtime for Pi, Codex, shells, and terminal agents.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "check": "pnpm run typecheck && pnpm test",
    "daemon": "node --experimental-strip-types src/cli/daemon.ts",
    "alfred2": "pnpm run web:build && node --experimental-strip-types src/alfred-2/cli.ts",
    "alfred2:no-wispr": "pnpm run web:build && ALFRED2_WISPR_LISTENER=0 node --experimental-strip-types src/alfred-2/cli.ts",
    "alfred2:stop": "node --experimental-strip-types src/alfred-2/stop.ts",
    "google:auth": "node --experimental-strip-types src/alfred-2/google-auth.ts",
    "token:copy": "node --experimental-strip-types src/cli/copy-token.ts",
    "web:build": "pnpm --dir web run build",
    "web:dev": "pnpm --dir web run dev",
    "typecheck": "tsc --noEmit && pnpm --dir web run typecheck",
    "pretest": "pnpm run web:build",
    "test": "ALFRED_SILENT_TESTS=1 node --test --experimental-strip-types test/*.test.ts && pnpm --dir web test"
  },
  "keywords": [
    "alfred",
    "cmux",
    "local-assistant",
    "terminal-agent"
  ],
  "packageManager": "pnpm@11.10.0",
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "exa-js": "^2.14.0"
  }
}
