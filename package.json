{
  "name": "alfred-local",
  "version": "0.1.0",
  "private": true,
  "description": "A local, cmux-backed personal assistant runtime for Pi, Codex, shells, and terminal agents.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "check": "npm run typecheck && npm test",
    "daemon": "node --experimental-strip-types src/cli/daemon.ts",
    "token:copy": "node --experimental-strip-types src/cli/copy-token.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.ts"
  },
  "keywords": [
    "alfred",
    "cmux",
    "local-assistant",
    "terminal-agent"
  ],
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.3"
  }
}
